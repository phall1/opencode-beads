{
  "name": "@phall1/opencode-beads",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phall1/opencode-beads.git"
  },
  "description": "A native Beads workbench for OpenCode V2",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "server.ts",
    "tui.tsx",
    "tui.js",
    "rpc.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./tui": "./tui.js",
    "./rpc": "./rpc.ts"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run compile && bun test",
    "compile": "bun scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test",
    "test:tui": "opencode-drive run scripts/tui-drive.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.32",
    "@opencode/schema": "2.0.32",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "effect": "^4.0.1",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode/sdk": "2.0.32",
    "@opencode/theme": "2.0.32",
    "effect": "4.0.1",
    "@types/bun": "^1.4.3",
    "eslint": "^10.13.0",
    "opencode-drive": "2.3.0",
    "prettier": "^3.9.10",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.1",
    "seroval": "1.6.9",
    "seroval-plugins": "1.6.9"
  }
}
